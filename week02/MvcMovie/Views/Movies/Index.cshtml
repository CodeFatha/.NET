@model MvcMovie.Models.MovieGenreViewModel

@{
    ViewData["Title"] = "My Movie Picks";
}

<h1>My Movie Picks</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<form asp-controller="Movies" asp-action="Index" method="get" class="form-inline mb-2">
    <div class="form-group">
        <label class="form-control-label mx-2">Genre:
            <select asp-for="MovieGenre" asp-items="Model.Genres" class="form-control">
                <option value="">All</option>
            </select>
        </label>
        <label class="form-control-label">Year:
            <select asp-for="MovieYear" asp-items="Model.Years" class="form-control">
                <option value="">All</option>
            </select>
        </label>
        </select>
        <label class="form-control-label mx-2">Title:
            <input type="text" asp-for="SearchString" class="form-control" />
        </label>
        <input type="submit" value="Filter" class="btn btn-primary mb-1" />
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Movies![0].Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Movies![0].ReleaseDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Movies![0].Genre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Movies![0].Price)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Movies![0].Rating)
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Movies!)
        {
            <tr class="p-2">
                <td>
                    @Html.DisplayFor(modelItem => item.Title)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ReleaseDate)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Genre)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Price)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Rating)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
